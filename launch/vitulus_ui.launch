<launch>
  <node pkg="vitulus_ui" type="webnode" name="webnode" output="log" respawn="true" respawn_delay="5"/>
  <!-- 2026-08-03: local costmapa je v odom frame (audit A19); stary ros3d ji
       neumi TF-umistit — relay ji prerammuje do map pro UI. -->
  <node pkg="vitulus_ui" type="costmap_reframe" name="costmap_reframe" respawn="true" respawn_delay="2" output="log"/>

  <!-- 2026-10-18: camera overlays (lidar / obstacles / free / depth) for the
       UI camera, projected into the colour camera like the RViz Camera
       display. LAZY: subscribes its inputs (and /tf) only while the UI has a
       layer on; all layers off = no subscription, ~0 % CPU. -->
  <node pkg="vitulus_ui" type="camera_overlay" name="camera_overlay" respawn="true" respawn_delay="5" output="log">
    <param name="camera_info" value="/d435/color/camera_info"/>
    <param name="scan" value="/scan"/>
    <param name="obstacles" value="/obstacles_cloud"/>
    <param name="free" value="/ground_cloud"/>
    <param name="depth" value="/d435/aligned_depth_to_color/image_raw"/>
    <param name="fixed_frame" value="odom"/>
    <param name="rate" value="5.0"/>
    <param name="depth_rate" value="5.0"/>
    <param name="max_points" value="3000"/>
  </node>

  <!-- Caches the transient /nextion/log_info status strip into a persistent,
       size-rotated JSONL log and republishes recent history over ROS (latched)
       for the WebUI. Runs independently of the web frontend. -->
  <node pkg="vitulus_ui" type="status_logger" name="status_logger" output="log"/>

  <!-- Mapping v3 lifecycle manager: starts/stops the vitulus_mapping pipeline
       (terrain DEM + octomap + obstacle raster) on UI request; the pipeline
       itself runs only on demand. -->
  <node pkg="vitulus_mapping" type="mapping_manager" name="mapping_manager" output="log" respawn="true"/>

  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find vitulus_ui)/launch/rosconsole.conf"/>
  <node pkg="web_video_server" type="web_video_server" name="web_video_server" output="log"/>
  <node pkg="tf2_web_republisher" type="tf2_web_republisher" name="tf2_web_republisher" output="log" respawn="true" respawn_delay="2"/>
  <!-- <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"></include> -->
  <include file="$(find vitulus_ui)/launch/rosbridge_websocket.launch"></include>



</launch>
