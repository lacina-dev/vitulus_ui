<launch>
  <arg name="port" default="9090" />
  <arg name="address" default="0.0.0.0" />
  <arg name="ssl" default="false" />
  <arg name="certfile" default=""/>
  <arg name="keyfile" default="" />

  <arg name="retry_startup_delay" default="5" />

  

  <arg name="fragment_timeout" default="600" />
  <arg name="delay_between_messages" default="0" />
  <arg name="max_message_size" default="None" />
  <arg name="unregister_timeout" default="10" />
  <arg name="websocket_external_port" default="None" />

  <arg name="use_compression" default="true" />

  <arg name="authenticate" default="false" />

  <!-- T39 (2026-11-16): rosbridge pings every client each second and DROPS the connection when
       the pong does not come within websocket_ping_timeout (autobahn onAutoPingTimeout, the page
       sees close code 1006). A browser answers a ping only while it is taking data: Chrome does
       not read the socket while the page's main thread is busy (page start-up, a big layer), so
       with 4 s every page whose start-up took longer was dropped and connected again, sending
       its ~114 subscriptions again (measured: all 159 disconnects of 16. 11. were this timer;
       on the loaded robot's own computer page start-up kept the main thread 3-6 s and the
       pong came up to 4.6 s late).
       8 s: longer than those stalls (latest pong measured 4.3-4.6 s) and equal to the page's
       own dead-link check (vt_link.js drops a silent link after 8 s and opens a new one), so
       the server never keeps a connection longer than the client does. NOT longer: this timeout
       is also the upper bound for how late a command stuck in TCP during a network drop
       (motors ON, Undock, Go, a program start) can still be executed after the link returns.
       And NOT the rosbridge default 30 s: while a
       frozen client is connected, rosbridge holds every topic it subscribed without a queue for
       ALL other clients (measured: a healthy client's stream stopped for 4.5 s = this timeout),
       so the timeout is also the longest such freeze. It was 4 s since "more clients fix"
       (vitulus_webui c45fa69, 2025-05). Stopping the robot does not depend on it: a drive
       command lives 0.25 s (mobile_base_controller cmd_vel_timeout), cmd_vel_mux never repeats
       one. To go back: timeout 4. -->
  <arg name="websocket_ping_interval" default="1" />
  <arg name="websocket_ping_timeout" default="8" />
  <arg name="websocket_null_origin" default="true" />

  <arg name="topics_glob" default="[*]" />
  <arg name="services_glob" default="[*]" />
  <arg name="params_glob" default="[*]" />
  <arg name="bson_only_mode" default="false" />
  <!-- Output: screen, log -->
  <arg name="output" default="log" />

  <!-- Valid options for binary_encoder are "default", "b64" and "bson". -->
  <arg unless="$(arg bson_only_mode)" name="binary_encoder" default="default"/>

  <group if="$(arg ssl)">
    <node name="rosbridge_websocket" pkg="rosbridge_server" type="rosbridge_websocket" output="$(arg output)">
      <!-- T39: rosbridge runs ~290 threads (one per subscription and connection) and glibc
           gives them up to 64 malloc arenas (8 per core). Every big message packed in a
           thread (the 2 MB base map, grids, images) inflates that thread's arena and the
           freed memory is not returned: RSS grew by ~50-70 MB with every page that
           connected (443 MB after 4 short clients, 756 MB after 7, 2.1 GB within an hour
           of UI tests). Two arenas keep the freed memory reusable; Python holds the GIL,
           so the allocator lock is not contended. Takes effect on the next stack start. -->
      <env name="MALLOC_ARENA_MAX" value="2" />
      <param name="certfile" value="$(arg certfile)" />
      <param name="keyfile" value="$(arg keyfile)" />
      <param name="authenticate" value="$(arg authenticate)" />
      <param name="port" value="$(arg port)"/>
      <param name="address" value="$(arg address)"/>
      <param name="retry_startup_delay" value="$(arg retry_startup_delay)"/>
      <param name="fragment_timeout" value="$(arg fragment_timeout)"/>
      <param name="delay_between_messages" value="$(arg delay_between_messages)"/>
      <param name="max_message_size" value="$(arg max_message_size)"/>
      <param name="unregister_timeout" value="$(arg unregister_timeout)"/>
      <param name="use_compression" value="$(arg use_compression)"/>

      <param name="websocket_ping_interval" value="$(arg websocket_ping_interval)" />
      <param name="websocket_ping_timeout" value="$(arg websocket_ping_timeout)" />
      <param name="websocket_external_port" value="$(arg websocket_external_port)" />
      <param name="websocket_null_origin" value="$(arg websocket_null_origin)" />

      <param name="topics_glob" value="$(arg topics_glob)"/>
      <param name="services_glob" value="$(arg services_glob)"/>
      <param name="params_glob" value="$(arg params_glob)"/>
    </node>
  </group>
  <group unless="$(arg ssl)">
    <node name="rosbridge_websocket" pkg="rosbridge_server" type="rosbridge_websocket" output="$(arg output)">
      <!-- T39: rosbridge runs ~290 threads (one per subscription and connection) and glibc
           gives them up to 64 malloc arenas (8 per core). Every big message packed in a
           thread (the 2 MB base map, grids, images) inflates that thread's arena and the
           freed memory is not returned: RSS grew by ~50-70 MB with every page that
           connected (443 MB after 4 short clients, 756 MB after 7, 2.1 GB within an hour
           of UI tests). Two arenas keep the freed memory reusable; Python holds the GIL,
           so the allocator lock is not contended. Takes effect on the next stack start. -->
      <env name="MALLOC_ARENA_MAX" value="2" />
      <param name="authenticate" value="$(arg authenticate)" />
      <param name="port" value="$(arg port)"/>
      <param name="address" value="$(arg address)"/>
      <param name="retry_startup_delay" value="$(arg retry_startup_delay)"/>
      <param name="fragment_timeout" value="$(arg fragment_timeout)"/>
      <param name="delay_between_messages" value="$(arg delay_between_messages)"/>
      <param name="max_message_size" value="$(arg max_message_size)"/>
      <param name="unregister_timeout" value="$(arg unregister_timeout)"/>
      <param name="use_compression" value="$(arg use_compression)"/>

      <param name="websocket_ping_interval" value="$(arg websocket_ping_interval)" />
      <param name="websocket_ping_timeout" value="$(arg websocket_ping_timeout)" />
      <param name="websocket_external_port" value="$(arg websocket_external_port)" />

      <param name="topics_glob" value="$(arg topics_glob)"/>
      <param name="services_glob" value="$(arg services_glob)"/>
      <param name="params_glob" value="$(arg params_glob)"/>

      <param name="bson_only_mode" value="$(arg bson_only_mode)"/>
    </node>
  </group>

  <node name="rosapi" pkg="rosapi" type="rosapi_node" output="$(arg output)">
    <param name="topics_glob" value="$(arg topics_glob)"/>
    <param name="services_glob" value="$(arg services_glob)"/>
    <param name="params_glob" value="$(arg params_glob)"/>
  </node>
</launch>
